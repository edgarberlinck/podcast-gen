# Optional local-server narration provider configuration.
# The application does not automatically load this file. Export values into
# the server process environment or use a local secret manager.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional local-server Transistor API key. Never expose it to browser code.
# The application does not load this file; export this variable for the server.
TRANSISTOR_API_KEY=

# Host port for the local Docker Compose app.
STUDIO_PORT=8000

# Optional Codex CLI executable override for Fish Audio MCP generation.
# The default is "codex" resolved from the server process PATH.
CODEX_BIN=codex

# Host Codex home containing the OAuth login for the fish-audio MCP server.
# It is mounted at runtime into the container, never copied into the image.
CODEX_HOME_HOST=${HOME}/.codex
